# Copiar a .env y ajustar si hace falta. Todos los valores tienen
# equivalentes por defecto en docker-compose.yml, así que el archivo
# es opcional para desarrollo local.

# Base de datos
DB_USERNAME=sanderson
DB_PASSWORD=123456789
DB_DATABASE=cosmere
DB_SSL=false
DB_SYNCHRONIZE=true

# URL con la que Angular (build time) llama a la API.
# En Compose el navegador accede por localhost:3000.
API_URL=http://localhost:3000

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
