# Copiar a .env para ejecutar la API desde el host (npm run start:dev).
# En Docker Compose estas variables las inyecta el propio compose.
# En Render se configuran en el dashboard del servicio.

# ── Conexión a PostgreSQL ─────────────────────────────────────────────
# Opción 1: una sola URL (Render, Neon, etc.). Tiene prioridad sobre DB_*.
# DATABASE_URL=postgresql://usuario:password@host:5432/base?sslmode=require

# Opción 2: variables separadas (Compose, K8s, desarrollo local).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=sanderson
DB_PASSWORD=123456789
DB_DATABASE=cosmere

# SSL: true para Render y cualquier Postgres administrado.
DB_SSL=false

# ── Esquema y migraciones ─────────────────────────────────────────────
# true: TypeORM crea/actualiza el esquema automáticamente (desarrollo).
# false: usa migraciones. En Render debe quedar en false.
DB_SYNCHRONIZE=true

# Si es true, la app ejecuta las migraciones pendientes al arrancar.
# En Render: DB_SYNCHRONIZE=false y DB_MIGRATIONS_RUN=true.
DB_MIGRATIONS_RUN=false

# Reintentos de conexión si la base no responde al arrancar (cold start).
# 20 intentos x 5 s = 100 s de margen antes de rendirse.
DB_RETRY_ATTEMPTS=20
DB_RETRY_DELAY=5000
DB_RETRY_VERBOSE=false

# ── Servidor ──────────────────────────────────────────────────────────
# Render inyecta PORT automáticamente; localmente se usa 3000.
PORT=3000

# Orígenes permitidos por CORS, separados por comas. "*" permite todos.
# En producción: CORS_ORIGINS=https://sanderson-web.netlify.app
CORS_ORIGINS=*
